{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/appsettings.*.Local.json)",
      "Read(./**/secrets/**)",
      "Read(./**/seeds/**)",
      "Read(./**/testdata/**)",
      "Read(./**/*.pfx)",
      "Read(./**/*.pem)",
      "Read(./**/*.bak)",
      "Read(./**/*.dump)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Edit(./**/secrets/**)",
      "Read(./.git/config)",
      "Read(./**/.git-credentials)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-classified.sh"
          }
        ]
      }
    ]
  }
}
