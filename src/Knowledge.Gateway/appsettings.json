{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",

  "Policy": { "Path": "policy/phase-access.yaml" },

  "Auth": {
    "Mode": "Entra",
    "Entra": {
      "Instance": "https://login.microsoftonline.com/",
      "TenantId": "<tenant-id>",
      "ClientId": "<gateway-app-id>",
      "Audience": "api://knowledge-gateway"
    },
    "RoleMap": {
      "<developers-group-object-id>": "developers",
      "<product-owners-group-object-id>": "product-owners"
    }
  },

  "Repo": {
    "Source": "AzureRepos",
    "AzureRepos": { "Organization": "<org>", "Project": "<project>", "Repository": "<repo>", "Branch": "main" }
  },

  "WorkItems": {
    "Source": "AzureDevOps",
    "AzureDevOps": { "Organization": "<org>", "Project": "<project>" }
  },

  "Upstreams": []
}
